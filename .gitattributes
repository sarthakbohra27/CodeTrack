# ============================================================
# CodeTrack – .gitattributes
# Ensures consistent line endings across platforms
# ============================================================

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Java source files — always LF
*.java   text eol=lf
*.xml    text eol=lf
*.jsp    text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.txt    text eol=lf
*.properties text eol=lf

# Binary files — do not modify
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.jar    binary
*.war    binary
*.class  binary
